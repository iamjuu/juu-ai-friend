# Juu Mowlee — copy to .env and adjust if needed.
# Never put secrets in the React client. The frontend only talks to Express.

# Express
PORT=5050
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/juu_mowlee
MAX_AUDIO_MB=10
CHAT_HISTORY_LIMIT=8
REQUEST_TIMEOUT_MS=180000

# Gemini language model — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
